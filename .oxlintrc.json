{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "jsx-a11y",
    "nextjs",
    "vitest"
  ],
  "ignorePatterns": [
    ".next/**",
    "coverage/**",
    "node_modules/**",
    "playwright-report/**",
    "supabase/.temp/**",
    "test-results/**"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "vitest": {
      "typecheck": true
    }
  },
  "rules": {
    "import/no-cycle": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "globals": {
        "afterAll": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "beforeEach": "readonly",
        "describe": "readonly",
        "expect": "readonly",
        "it": "readonly",
        "test": "readonly",
        "vi": "readonly"
      }
    }
  ]
}
